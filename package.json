{
  "name": "fleet-service-planning-garage-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:frontend": "cd frontend && npx ng build --configuration production",
    "build": "npm run build:frontend && npx tsc -p backend/tsconfig.json --noEmit",
    "dev": "npm run build:frontend && tsx server.ts",
    "start": "tsx server.ts",
    "clean": "rm -rf frontend/dist backend/dist dist",
    "lint": "npx eslint firestore.rules && npx tsc -p backend/tsconfig.json --noEmit && cd frontend && npx tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/animations": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "eslint": "^9.22.0",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "jspdf": "^4.2.1",
    "lucide-angular": "^1.0.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.0",
    "rxjs": "^7.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
