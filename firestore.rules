rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdminEmail() {
      return isVerified() && request.auth.token.email == 'anmolsggouda@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'anmolsggouda@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(data) {
      return isVerified() && data.ownerUid is string && data.ownerUid == request.auth.uid;
    }

    // Validation Blueprints
    function isValidGarageConfig(data) {
      return data.keys().hasAll([
        'garageName', 'address', 'phone', 'email', 'taxEnabled',
        'taxRatePercent', 'currencySymbol', 'invoicePrefix', 'nextInvoiceSequence', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'garageName', 'tagline', 'address', 'phone', 'email',
        'gstNumber', 'taxEnabled', 'taxRatePercent', 'currencySymbol',
        'invoicePrefix', 'nextInvoiceSequence', 'ownerUid', 'updatedAt'
      ]) &&
      isValidStr(data.garageName, 1, 160) &&
      isValidStr(data.address, 1, 300) &&
      isValidStr(data.phone, 1, 40) &&
      isValidStr(data.email, 3, 120) &&
      (!('tagline' in data) || isValidStr(data.tagline, 0, 240)) &&
      (!('gstNumber' in data) || isValidStr(data.gstNumber, 0, 40)) &&
      data.taxEnabled is bool &&
      data.taxRatePercent is number && data.taxRatePercent >= 0 && data.taxRatePercent <= 50 &&
      isValidStr(data.currencySymbol, 1, 8) &&
      isValidStr(data.invoicePrefix, 1, 16) &&
      data.nextInvoiceSequence is number && data.nextInvoiceSequence >= 1 &&
      isValidId(data.ownerUid);
    }

    function isValidVehicle(data) {
      return data.keys().hasAll([
        'id', 'registrationNumber', 'model', 'equipmentGroup', 'category',
        'categoryLabel', 'imagePath', 'odometer', 'engineRunningHours',
        'maintenancePlan', 'nextServiceDate', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'registrationNumber', 'manufacturer', 'model', 'manufacturingYear',
        'equipmentGroup', 'category', 'categoryLabel', 'imagePath', 'odometer',
        'engineRunningHours', 'maintenancePlan', 'nextServiceDate', 'assignedGarage',
        'customerName', 'customerPhone', 'customerEmail', 'otherServiceActivities',
        'notes', 'maintenanceChecklist', 'repairChecklist', 'serviceHistory', 'ownerUid'
      ]) &&
      isValidId(data.id) &&
      isValidStr(data.registrationNumber, 1, 40) &&
      isValidStr(data.model, 1, 100) &&
      isValidStr(data.equipmentGroup, 1, 80) &&
      data.category in ['box_truck', 'container_truck', 'dump_truck', 'concrete_mixer', 'flatbed_trailer', 'tanker_truck'] &&
      isValidStr(data.categoryLabel, 1, 60) &&
      isValidStr(data.imagePath, 1, 200) &&
      data.odometer is number && data.odometer >= 0 &&
      data.engineRunningHours is number && data.engineRunningHours >= 0 &&
      isValidStr(data.maintenancePlan, 1, 200) &&
      isValidStr(data.nextServiceDate, 1, 40) &&
      (!('notes' in data) || isValidStr(data.notes, 0, 1000)) &&
      (!('maintenanceChecklist' in data) || (data.maintenanceChecklist is list && data.maintenanceChecklist.size() <= 100)) &&
      (!('repairChecklist' in data) || (data.repairChecklist is list && data.repairChecklist.size() <= 100)) &&
      (!('serviceHistory' in data) || (data.serviceHistory is list && data.serviceHistory.size() <= 200)) &&
      isValidId(data.ownerUid);
    }

    function isValidBooking(data) {
      return data.keys().hasAll([
        'id', 'bookingRef', 'vehicleId', 'vehicleReg', 'workflowColumn',
        'calendarStatus', 'date', 'startTime', 'endTime', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'bookingRef', 'vehicleId', 'vehicleReg', 'vehicleCategory', 'vehicleModel',
        'equipmentGroup', 'title', 'serviceType', 'serviceActivities', 'workshopLocation',
        'workflowColumn', 'calendarStatus', 'date', 'startTime', 'endTime', 'badgeType',
        'badgeDateStr', 'isPriority', 'notes', 'customerName', 'customerPhone', 'customerEmail',
        'estimatedMaterials', 'actualMaterials', 'additionalMaterials', 'labourCharges',
        'additionalServiceCharges', 'discountAmount', 'workPerformedDescription',
        'invoiceId', 'invoiceNumber', 'invoiceStatus', 'ownerUid'
      ]) &&
      isValidId(data.id) &&
      isValidStr(data.bookingRef, 1, 32) &&
      isValidId(data.vehicleId) &&
      isValidStr(data.vehicleReg, 1, 40) &&
      data.workflowColumn in ['service_events_to_book', 'preliminary_bookings', 'confirmed_bookings', 'in_progress'] &&
      data.calendarStatus in ['delayed', 'due', 'preliminary', 'performed', 'confirmed', 'planned'] &&
      isValidStr(data.date, 8, 20) &&
      isValidStr(data.startTime, 4, 10) &&
      isValidStr(data.endTime, 4, 10) &&
      (!('notes' in data) || isValidStr(data.notes, 0, 1000)) &&
      (!('estimatedMaterials' in data) || (data.estimatedMaterials is list && data.estimatedMaterials.size() <= 100)) &&
      (!('actualMaterials' in data) || (data.actualMaterials is list && data.actualMaterials.size() <= 100)) &&
      (!('additionalMaterials' in data) || (data.additionalMaterials is list && data.additionalMaterials.size() <= 100)) &&
      isValidId(data.ownerUid);
    }

    function isValidSupplier(data) {
      return data.keys().hasAll([
        'id', 'name', 'contactPerson', 'mobile', 'email', 'address', 'isActive', 'createdAt', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'name', 'contactPerson', 'mobile', 'email', 'address', 'isActive', 'createdAt', 'ownerUid'
      ]) &&
      isValidId(data.id) &&
      isValidStr(data.name, 1, 140) &&
      isValidStr(data.contactPerson, 1, 120) &&
      isValidStr(data.mobile, 1, 40) &&
      isValidStr(data.email, 1, 120) &&
      isValidStr(data.address, 1, 300) &&
      data.isActive is bool &&
      isValidStr(data.createdAt, 1, 40) &&
      isValidId(data.ownerUid);
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll([
        'id', 'partName', 'sku', 'category', 'unit', 'quantityOnHand', 'minimumStock',
        'purchaseCost', 'sellingPrice', 'supplierId', 'isActive', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'partName', 'sku', 'category', 'description', 'unit', 'quantityOnHand',
        'minimumStock', 'storageLocation', 'purchaseCost', 'sellingPrice', 'supplierId',
        'supplierName', 'isActive', 'updatedAt', 'ownerUid'
      ]) &&
      isValidId(data.id) &&
      isValidStr(data.partName, 1, 160) &&
      isValidStr(data.sku, 1, 64) &&
      isValidStr(data.category, 1, 80) &&
      isValidStr(data.unit, 1, 32) &&
      data.quantityOnHand is number && data.quantityOnHand >= 0 &&
      data.minimumStock is number && data.minimumStock >= 0 &&
      data.purchaseCost is number && data.purchaseCost >= 0 &&
      data.sellingPrice is number && data.sellingPrice >= 0 &&
      isValidId(data.supplierId) &&
      data.isActive is bool &&
      (!('description' in data) || isValidStr(data.description, 0, 400)) &&
      isValidId(data.ownerUid);
    }

    function isValidServiceTemplate(data) {
      return data.keys().hasAll([
        'id', 'name', 'description', 'defaultLabourCharge', 'materials', 'isCustom', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'name', 'description', 'defaultLabourCharge', 'materials', 'isCustom', 'ownerUid'
      ]) &&
      isValidId(data.id) &&
      isValidStr(data.name, 1, 120) &&
      isValidStr(data.description, 0, 400) &&
      data.defaultLabourCharge is number && data.defaultLabourCharge >= 0 &&
      data.materials is list && data.materials.size() <= 50 &&
      data.isCustom is bool &&
      isValidId(data.ownerUid);
    }

    function isValidInvoice(data) {
      return data.keys().hasAll([
        'id', 'invoiceNumber', 'repairJobId', 'bookingRef', 'invoiceDate', 'createdAt',
        'customerName', 'customerPhone', 'vehicleId', 'vehicleReg', 'lineItems',
        'finalPayableAmount', 'paymentStatus', 'amountPaid', 'paymentMethod', 'status', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'invoiceNumber', 'repairJobId', 'bookingRef', 'invoiceDate', 'createdAt',
        'customerName', 'customerPhone', 'customerEmail', 'vehicleId', 'vehicleReg',
        'vehicleMakeModel', 'odometerReading', 'serviceType', 'workPerformed', 'lineItems',
        'materialsSubtotal', 'labourCharges', 'additionalServiceCharges', 'discountAmount',
        'taxEnabled', 'taxRatePercent', 'taxAmount', 'finalPayableAmount', 'paymentStatus',
        'amountPaid', 'paymentMethod', 'status', 'cancelledAt', 'cancelReason',
        'garageSnapshot', 'ownerUid'
      ]) &&
      isValidId(data.id) &&
      isValidStr(data.invoiceNumber, 1, 40) &&
      isValidId(data.repairJobId) &&
      isValidId(data.vehicleId) &&
      isValidStr(data.customerName, 1, 140) &&
      isValidStr(data.customerPhone, 1, 40) &&
      data.lineItems is list && data.lineItems.size() <= 200 &&
      data.finalPayableAmount is number && data.finalPayableAmount >= 0 &&
      data.paymentStatus in ['Paid', 'Unpaid', 'Partially Paid'] &&
      data.amountPaid is number && data.amountPaid >= 0 &&
      data.paymentMethod in ['Cash', 'Card', 'UPI / Bank Transfer', 'Corporate Credit'] &&
      data.status in ['active', 'cancelled'] &&
      isValidId(data.ownerUid);
    }

    function isValidStockMovement(data) {
      return data.keys().hasAll([
        'id', 'transactionCode', 'inventoryItemId', 'partName', 'sku', 'unit',
        'transactionType', 'previousQuantity', 'quantityDelta', 'updatedQuantity',
        'timestamp', 'performedBy', 'remarks', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'transactionCode', 'inventoryItemId', 'partName', 'sku', 'unit',
        'transactionType', 'previousQuantity', 'quantityDelta', 'updatedQuantity',
        'repairJobId', 'invoiceNumber', 'supplierId', 'supplierName',
        'timestamp', 'performedBy', 'remarks', 'ownerUid'
      ]) &&
      isValidId(data.id) &&
      isValidStr(data.transactionCode, 1, 40) &&
      isValidId(data.inventoryItemId) &&
      isValidStr(data.partName, 1, 160) &&
      isValidStr(data.sku, 1, 64) &&
      data.transactionType in ['stock_in', 'service_consumption', 'manual_adjustment', 'purchase_return', 'invoice_reversal'] &&
      data.previousQuantity is number &&
      data.quantityDelta is number &&
      data.updatedQuantity is number && data.updatedQuantity >= 0 &&
      isValidStr(data.timestamp, 1, 40) &&
      isValidStr(data.performedBy, 1, 100) &&
      isValidStr(data.remarks, 0, 400) &&
      isValidId(data.ownerUid);
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
        'id', 'type', 'title', 'message', 'workshop', 'timeAgo', 'timestamp', 'dismissed', 'ownerUid'
      ]) && data.keys().hasOnly([
        'id', 'type', 'title', 'message', 'workshop', 'bookingRef',
        'inventoryItemId', 'timeAgo', 'timestamp', 'dismissed', 'ownerUid'
      ]) &&
      isValidId(data.id) &&
      data.type in ['proposal', 'confirmed', 'performed', 'delayed', 'repair', 'low_stock'] &&
      isValidStr(data.title, 1, 120) &&
      isValidStr(data.message, 1, 500) &&
      isValidStr(data.workshop, 1, 160) &&
      data.dismissed is bool &&
      isValidId(data.ownerUid);
    }

    // Collection Match Blocks
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /garageConfig/{configId} {
      allow get: if isValidId(configId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(configId) && isValidGarageConfig(incoming()) && incoming().ownerUid == request.auth.uid;
      allow update: if isVerified() && isValidId(configId) && isValidGarageConfig(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        (isAdmin() || (
          isOwner(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'garageName', 'tagline', 'address', 'phone', 'email', 'gstNumber',
            'taxEnabled', 'taxRatePercent', 'currencySymbol', 'invoicePrefix', 'nextInvoiceSequence', 'updatedAt'
          ])
        ));
      allow delete: if isAdmin();
    }

    match /vehicles/{vehicleId} {
      allow get: if isValidId(vehicleId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(vehicleId) && isValidVehicle(incoming()) && incoming().ownerUid == request.auth.uid;
      allow update: if isVerified() && isValidId(vehicleId) && isValidVehicle(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        (isAdmin() || (
          isOwner(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'odometer', 'engineRunningHours', 'maintenancePlan', 'nextServiceDate',
            'customerName', 'customerPhone', 'customerEmail', 'notes',
            'maintenanceChecklist', 'repairChecklist', 'serviceHistory'
          ])
        ));
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(bookingId) && isValidBooking(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        exists(/databases/$(database)/documents/vehicles/$(incoming().vehicleId));
      allow update: if isVerified() && isValidId(bookingId) && isValidBooking(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().vehicleId == existing().vehicleId &&
        (isAdmin() || (
          isOwner(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'workflowColumn', 'calendarStatus', 'date', 'startTime', 'endTime',
            'badgeType', 'badgeDateStr', 'notes', 'customerName', 'customerPhone', 'customerEmail',
            'estimatedMaterials', 'actualMaterials', 'additionalMaterials',
            'labourCharges', 'additionalServiceCharges', 'discountAmount',
            'workPerformedDescription', 'invoiceId', 'invoiceNumber', 'invoiceStatus'
          ])
        ));
      allow delete: if isValidId(bookingId) && (isOwner(existing()) || isAdmin());
    }

    match /suppliers/{supplierId} {
      allow get: if isValidId(supplierId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(supplierId) && isValidSupplier(incoming()) && incoming().ownerUid == request.auth.uid;
      allow update: if isVerified() && isValidId(supplierId) && isValidSupplier(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        (isAdmin() || (
          isOwner(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'contactPerson', 'mobile', 'email', 'address', 'isActive'
          ])
        ));
      allow delete: if isAdmin();
    }

    match /inventory/{itemId} {
      allow get: if isValidId(itemId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(itemId) && isValidInventoryItem(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        exists(/databases/$(database)/documents/suppliers/$(incoming().supplierId));
      allow update: if isVerified() && isValidId(itemId) && isValidInventoryItem(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        (isAdmin() || (
          isOwner(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'partName', 'sku', 'category', 'description', 'unit', 'quantityOnHand',
            'minimumStock', 'storageLocation', 'purchaseCost', 'sellingPrice',
            'supplierId', 'supplierName', 'isActive', 'updatedAt'
          ])
        ));
      allow delete: if isAdmin();
    }

    match /serviceTemplates/{templateId} {
      allow get: if isValidId(templateId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(templateId) && isValidServiceTemplate(incoming()) && incoming().ownerUid == request.auth.uid;
      allow update: if isVerified() && isValidId(templateId) && isValidServiceTemplate(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        (isAdmin() || (
          isOwner(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'defaultLabourCharge', 'materials'])
        ));
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow get: if isValidId(invoiceId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(invoiceId) && isValidInvoice(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        exists(/databases/$(database)/documents/bookings/$(incoming().repairJobId));
      allow update: if isVerified() && isValidId(invoiceId) && isValidInvoice(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().invoiceNumber == existing().invoiceNumber &&
        incoming().repairJobId == existing().repairJobId &&
        existing().status != 'cancelled' &&
        (isAdmin() || (
          isOwner(existing()) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'paymentStatus', 'amountPaid', 'paymentMethod', 'status', 'cancelledAt', 'cancelReason'
          ])
        ));
      allow delete: if false;
    }

    match /stockMovements/{movementId} {
      allow get: if isValidId(movementId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(movementId) && isValidStockMovement(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        exists(/databases/$(database)/documents/inventory/$(incoming().inventoryItemId));
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && (isOwner(existing()) || isAdmin());
      allow list: if isOwner(existing()) || isBootstrappedAdminEmail();
      allow create: if isVerified() && isValidId(notificationId) && isValidNotification(incoming()) && incoming().ownerUid == request.auth.uid;
      allow update: if isVerified() && isValidId(notificationId) && isValidNotification(incoming()) &&
        incoming().ownerUid == existing().ownerUid &&
        (isAdmin() || (isOwner(existing()) && incoming().diff(existing()).affectedKeys().hasOnly(['dismissed'])));
      allow delete: if isAdmin();
    }
  }
}
