{
  "entities": {
    "GarageConfig": {
      "title": "GarageConfig",
      "description": "Single-garage identity, tax configuration, and invoice numbering sequence.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "garageName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "tagline": { "type": "string", "maxLength": 240 },
        "address": { "type": "string", "minLength": 1, "maxLength": 300 },
        "phone": { "type": "string", "minLength": 1, "maxLength": 40 },
        "email": { "type": "string", "format": "email", "maxLength": 120 },
        "gstNumber": { "type": "string", "maxLength": 40 },
        "taxEnabled": { "type": "boolean" },
        "taxRatePercent": { "type": "number" },
        "currencySymbol": { "type": "string", "minLength": 1, "maxLength": 8 },
        "invoicePrefix": { "type": "string", "minLength": 1, "maxLength": 16 },
        "nextInvoiceSequence": { "type": "integer" },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["garageName", "address", "phone", "email", "taxEnabled", "taxRatePercent", "currencySymbol", "invoicePrefix", "nextInvoiceSequence"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Registered commercial fleet vehicle with telemetry, checklists, and service history.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "registrationNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "manufacturer": { "type": "string", "maxLength": 80 },
        "model": { "type": "string", "minLength": 1, "maxLength": 100 },
        "manufacturingYear": { "type": "integer" },
        "equipmentGroup": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "enum": ["box_truck", "container_truck", "dump_truck", "concrete_mixer", "flatbed_trailer", "tanker_truck"] },
        "categoryLabel": { "type": "string", "maxLength": 60 },
        "imagePath": { "type": "string", "maxLength": 200 },
        "odometer": { "type": "number" },
        "engineRunningHours": { "type": "number" },
        "maintenancePlan": { "type": "string", "maxLength": 200 },
        "nextServiceDate": { "type": "string", "maxLength": 40 },
        "assignedGarage": { "type": "string", "maxLength": 160 },
        "customerName": { "type": "string", "maxLength": 120 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "customerEmail": { "type": "string", "maxLength": 120 },
        "otherServiceActivities": { "type": "string", "maxLength": 240 },
        "notes": { "type": "string", "maxLength": 1000 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "registrationNumber", "model", "equipmentGroup", "category", "categoryLabel", "imagePath", "odometer", "engineRunningHours", "maintenancePlan", "nextServiceDate"]
    },
    "ServiceBooking": {
      "title": "ServiceBooking",
      "description": "Service booking and repair job lifecycle across Kanban workflow columns and calendar.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingRef": { "type": "string", "minLength": 1, "maxLength": 32 },
        "vehicleId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vehicleReg": { "type": "string", "maxLength": 40 },
        "vehicleCategory": { "type": "string", "enum": ["box_truck", "container_truck", "dump_truck", "concrete_mixer", "flatbed_trailer", "tanker_truck"] },
        "vehicleModel": { "type": "string", "maxLength": 100 },
        "equipmentGroup": { "type": "string", "maxLength": 80 },
        "title": { "type": "string", "maxLength": 160 },
        "serviceType": { "type": "string", "maxLength": 100 },
        "serviceActivities": { "type": "string", "maxLength": 400 },
        "workshopLocation": { "type": "string", "maxLength": 160 },
        "workflowColumn": { "type": "string", "enum": ["service_events_to_book", "preliminary_bookings", "confirmed_bookings", "in_progress"] },
        "calendarStatus": { "type": "string", "enum": ["delayed", "due", "preliminary", "performed", "confirmed", "planned"] },
        "date": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "endTime": { "type": "string", "maxLength": 10 },
        "badgeType": { "type": "string", "maxLength": 32 },
        "badgeDateStr": { "type": "string", "maxLength": 80 },
        "labourCharges": { "type": "number" },
        "additionalServiceCharges": { "type": "number" },
        "discountAmount": { "type": "number" },
        "invoiceStatus": { "type": "string", "enum": ["none", "generated", "cancelled"] },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "bookingRef", "vehicleId", "vehicleReg", "workflowColumn", "calendarStatus", "date", "startTime", "endTime"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Master spare parts vendor record for the garage.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "contactPerson": { "type": "string", "maxLength": 120 },
        "mobile": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 300 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 40 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "contactPerson", "mobile", "email", "address", "isActive", "createdAt"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Catalogued spare part or consumable item with stock level and pricing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
        "category": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 400 },
        "unit": { "type": "string", "maxLength": 32 },
        "quantityOnHand": { "type": "number" },
        "minimumStock": { "type": "number" },
        "storageLocation": { "type": "string", "maxLength": 40 },
        "purchaseCost": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "supplierId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "supplierName": { "type": "string", "maxLength": 140 },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 40 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "partName", "sku", "category", "unit", "quantityOnHand", "minimumStock", "purchaseCost", "sellingPrice", "supplierId", "isActive"]
    },
    "ServiceTemplate": {
      "title": "ServiceTemplate",
      "description": "Predefined or custom service template with default spare-parts bill of materials.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 400 },
        "defaultLabourCharge": { "type": "number" },
        "isCustom": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "name", "description", "defaultLabourCharge", "isCustom"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Finalized garage tax invoice with immutable line-item snapshot and cancellation state.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "invoiceNumber": { "type": "string", "minLength": 1, "maxLength": 40 },
        "repairJobId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "bookingRef": { "type": "string", "maxLength": 32 },
        "invoiceDate": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "maxLength": 40 },
        "customerName": { "type": "string", "maxLength": 140 },
        "customerPhone": { "type": "string", "maxLength": 40 },
        "vehicleId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "vehicleReg": { "type": "string", "maxLength": 40 },
        "finalPayableAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Unpaid", "Partially Paid"] },
        "amountPaid": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Card", "UPI / Bank Transfer", "Corporate Credit"] },
        "status": { "type": "string", "enum": ["active", "cancelled"] },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "invoiceNumber", "repairJobId", "invoiceDate", "customerName", "vehicleId", "finalPayableAmount", "paymentStatus", "status"]
    },
    "StockMovement": {
      "title": "StockMovement",
      "description": "Immutable stock movement audit ledger entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "transactionCode": { "type": "string", "maxLength": 40 },
        "inventoryItemId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "partName": { "type": "string", "maxLength": 160 },
        "sku": { "type": "string", "maxLength": 64 },
        "unit": { "type": "string", "maxLength": 32 },
        "transactionType": { "type": "string", "enum": ["stock_in", "service_consumption", "manual_adjustment", "purchase_return", "invoice_reversal"] },
        "previousQuantity": { "type": "number" },
        "quantityDelta": { "type": "number" },
        "updatedQuantity": { "type": "number" },
        "timestamp": { "type": "string", "maxLength": 40 },
        "performedBy": { "type": "string", "maxLength": 100 },
        "remarks": { "type": "string", "maxLength": 400 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "transactionCode", "inventoryItemId", "partName", "sku", "transactionType", "previousQuantity", "quantityDelta", "updatedQuantity", "timestamp"]
    },
    "FleetNotification": {
      "title": "FleetNotification",
      "description": "Workshop and low-stock alert notification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["proposal", "confirmed", "performed", "delayed", "repair", "low_stock"] },
        "title": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 500 },
        "workshop": { "type": "string", "maxLength": 160 },
        "timestamp": { "type": "string", "maxLength": 40 },
        "dismissed": { "type": "boolean" },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "type", "title", "message", "workshop", "timestamp", "dismissed"]
    }
  },
  "firestore": {
    "/garageConfig/{configId}": {
      "schema": { "$ref": "#/entities/GarageConfig" },
      "description": "Single-garage identity, tax settings, and invoice sequence."
    },
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Fleet vehicle registry with telemetry and checklists."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/ServiceBooking" },
      "description": "Repair job bookings and calendar slots."
    },
    "/suppliers/{supplierId}": {
      "schema": { "$ref": "#/entities/Supplier" },
      "description": "Master vendor/supplier records."
    },
    "/inventory/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Spare parts inventory items and pricing."
    },
    "/serviceTemplates/{templateId}": {
      "schema": { "$ref": "#/entities/ServiceTemplate" },
      "description": "Standard and custom service BOM templates."
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Generated and cancelled garage tax invoices."
    },
    "/stockMovements/{movementId}": {
      "schema": { "$ref": "#/entities/StockMovement" },
      "description": "Immutable inventory stock movement ledger."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/FleetNotification" },
      "description": "Workshop workflow and low-stock notifications."
    }
  }
}
